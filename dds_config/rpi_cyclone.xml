<!--
  CycloneDDS configuration for the Raspberry Pi.

  Goals:
    (a) Local participant discovery between separate ROS terminals on
        this Pi always works, even when the direct-ethernet link to
        the Jetson is not yet configured (no 192.168.10.2 interface).
    (b) Cross-machine discovery to the Jetson works over the direct
        ethernet link once 192.168.10.2 is up.

  Why this shape:
    Previous revisions pinned the interface to a hardcoded name
    ("eth0") or address. If the kernel renames the interface, or the
    Pi is booted without the Jetson cable, Cyclone has nothing to
    bind and `ros2 node list` returns empty even though every node is
    running fine inside the launch.

    Now: we declare the direct-link IP as a "best-effort" interface
    (presence_required=false → Cyclone does NOT fail if it is missing)
    AND let Cyclone autodetect the system default so there is always
    at least one usable interface for local discovery.

  Network topology:
    RPi     IP: 192.168.10.2 / 24   (this machine; optional at boot)
    Jetson  IP: 192.168.10.1 / 24   (peer)

  Apply with:
    export CYCLONEDDS_URI=file://$HOME/anubix_rpi_ws/dds_config/rpi_cyclone.xml
    export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
    export ROS_DOMAIN_ID=42
-->
<CycloneDDS>
  <Domain id="any">

    <General>
      <Interfaces>
        <!--
          Preferred interface: direct ethernet link to the Jetson.
          presence_required="false" lets Cyclone fall back to the
          autodetected interface when 192.168.10.2 isn't up yet.
        -->
        <NetworkInterface address="192.168.10.2" presence_required="false" priority="10"/>
        <!--
          Fallback: pick the system default interface so local
          discovery always has a working transport.
        -->
        <NetworkInterface autodetermine="true" priority="0"/>
      </Interfaces>
      <!--
        SPDP = multicast for participant discovery only; bulk data
        still flows unicast. Keeps the direct link free of heavy
        multicast while letting local processes find each other.
      -->
      <AllowMulticast>spdp</AllowMulticast>
    </General>

    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>32</MaxAutoParticipantIndex>
      <Peers>
        <!-- localhost: guarantees cross-terminal discovery on this Pi -->
        <Peer address="localhost"/>
        <!-- Jetson over the direct ethernet link -->
        <Peer address="192.168.10.1"/>
      </Peers>
    </Discovery>

    <Tracing>
      <!-- Set to "config" or "finest" for deep DDS debugging -->
      <Verbosity>warning</Verbosity>
      <OutputFile>stderr</OutputFile>
    </Tracing>

  </Domain>
</CycloneDDS>
